# Required
BOT_TOKEN=123456:ABC-your-telegram-bot-token
TEMPORASMS_API_KEY=your-temporasms-api-key
ADMIN_ID=123456789

# Optional
DB_PATH=./bot.db          # on Railway set to /data/bot.db and mount a volume
DEFAULT_COUNTRY=22        # numeric id from /countries (22 = India)
LOCK_COUNTRY=1            # 1: commands take no COUNTRY arg, always DEFAULT_COUNTRY. 0: /buy SERVICE COUNTRY [MAXPRICE]
DEFAULT_OPERATOR=smart    # smart|auto|cheap|best or a numeric id from /operators; /op switches live
ANY_SERVICE=              # catch-all service code for /number; empty = auto-detect by name, /any CODE overrides
LIST_OPERATOR=1           # numeric id used by /services /countries /price when the operator is a mode
POLL_INTERVAL=5           # seconds between getStatus sweeps
ACTIVATION_TTL=1200       # activation window in seconds (20 min convention)
MAX_LIVE=5                # refuse to buy past this many open activations
